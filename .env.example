# ─────────────────────────────────────────────────────────────────────────────
# Template untuk file .env di EC2 production
# Salin ke .env lalu isi semua nilai — JANGAN commit .env ke git
# ─────────────────────────────────────────────────────────────────────────────

# Docker
GITHUB_REPOSITORY_OWNER=your-github-username-or-org

# PostgreSQL
DB_NAME=recruitment_db
DB_USERNAME=recruitment_user
DB_PASSWORD=

# AWS S3
# Buat S3 bucket di AWS Console, region ap-southeast-3 (Jakarta)
# Buat IAM user dengan policy AmazonS3FullAccess (atau custom ke bucket saja)
AWS_REGION=ap-southeast-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=your-bucket-name

# JWT
JWT_SECRET=

# SMTP Email
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Recruitment System
SMTP_FROM_EMAIL=noreply@yourdomain.com

# FastAPI / LLM
OLLAMA_HOST=http://your-ollama-host:11434
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# NestJS
SERVICE_CODE=RECRUITMENT

# CORS — kosongkan untuk allow all (ok untuk tugas akhir)
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Secrets yang perlu di-set di repository Settings > Secrets
# ─────────────────────────────────────────────────────────────────────────────
# EC2_HOST              = Elastic IP address EC2
# EC2_SSH_PRIVATE_KEY   = Isi private key ED25519 (bukan path, isi file-nya)
# GHCR_TOKEN            = GitHub PAT dengan scope read:packages
# GITHUB_REPOSITORY_OWNER = GitHub username atau organization
# ... semua variabel di atas juga perlu disimpan sebagai GitHub Secret
